# Copier en deploy/.env et remplir. Ne jamais committer le fichier .env.

# ── Obligatoire ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# Chiffrement des documents sur le disque. Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# À conserver AUSSI hors du serveur (coffre-fort) : sans elle, les documents et leurs sauvegardes sont
# illisibles. Rotation : mettre la nouvelle clé en premier (« nouvelle,ancienne »), puis
# « python manage.py encrypt_files --rotate », puis retirer l'ancienne.
FILE_ENCRYPTION_KEYS=
DJANGO_ALLOWED_HOSTS=www.fajma.sn,fajma.sn
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.fajma.sn,https://fajma.sn
PUBLIC_SITE_URL=https://www.fajma.sn
# Supervision : adresses prévenues par email en cas de problème (séparées par des virgules).
ALERT_EMAILS=
# Jeton de la supervision externe : /api/health?token=... donne le détail de chaque composant
HEALTH_TOKEN=
# Durées de conservation des données techniques (jours), purgées chaque nuit. Voir settings.RETENTION_DAYS.
# Les données médicales ne sont jamais purgées automatiquement (durée légale à fixer avec un juriste).
# RETENTION_AUDIT_DAYS=1825
# Comptes professionnels : déconnexion après N minutes sans activité (défaut 30).
# PRO_IDLE_MINUTES=30
# RETENTION_SMS_DAYS=365
# RETENTION_WALK_IN_DAYS=1825
# Double authentification obligatoire pour médecins, pharmaciens, cliniques et administrateurs.
# Ne jamais mettre à 0 en production (données de santé).
MFA_REQUIRED_FOR_PROS=1

# ── Emails (SMTP) ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fajma <no-reply@fajma.sn>

# ── Paiement PayDunya ────────────────────────────────────────────────
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=live

# ── Twilio (SMS, WhatsApp) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_TOKEN=

# ── Menu USSD (agrégateur : Africa's Talking, Orange…) ──────────────
# Secret envoyé par l'agrégateur dans l'en-tête X-Ussd-Secret (ou ?secret=). Vide = USSD désactivé.
USSD_SECRET=

# ── Notifications push (téléphone, gratuit) ─────────────────────────
# Générer une fois : docker compose -f deploy/docker-compose.yml run --rm backend python manage.py vapid_keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_CONTACT=mailto:contact@fajma.sn

# ── Téléconsultation (serveur Jitsi) ─────────────────────────────────
JITSI_DOMAIN=meet.jit.si

# ── Assistant IA ─────────────────────────────────────────────────────
AI_API_KEY=
AI_MODEL=
# Assistant de prise de notes des médecins : envoie le texte des notes au fournisseur d'IA ci-dessus.
# Laisser à false tant que ce transfert n'est pas autorisé (CDP, contrat) : mise en forme locale sans IA.
AI_NOTES_ENABLED=false

# ── Supervision (facultatif) ─────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Sauvegardes quotidiennes (deploy/backups) : phrase secrète de chiffrement, à conserver hors du serveur.
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=30
