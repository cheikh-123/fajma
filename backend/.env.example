# Copier en backend/.env pour le développement local. Toutes les valeurs sont facultatives en local.

DJANGO_DEBUG=true
# Obligatoire en production (chaîne aléatoire longue) :
# DJANGO_SECRET_KEY=
# Obligatoire en production (chiffrement des documents) ; en développement, dérivée de la clé secrète.
# FILE_ENCRYPTION_KEYS=
# Antivirus (hôte:port de clamd) ; vide = pas d'analyse.
# CLAMAV_ADDRESS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_SITE_URL=http://localhost:8080

# Fichiers déposés par les patients (hors de tout dossier public)
# PRIVATE_MEDIA_ROOT=

# Emails (en local, affichés dans la console du serveur Django)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST= / EMAIL_PORT=587 / EMAIL_HOST_USER= / EMAIL_HOST_PASSWORD=

# Paiement PayDunya (sans clés : seul le paiement au cabinet est proposé)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Twilio (SMS et WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_TOKEN=

# Assistant IA (API compatible OpenAI ; Google Gemini par défaut)
AI_API_KEY=
AI_MODEL=
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# ── Base de données (vide = SQLite locale) ───────────────────────────
# DATABASE_URL=postgres://fajma:motdepasse@localhost:5432/fajma
# DATABASE_SSLMODE=require

# ── File de tâches (SMS, emails) ─────────────────────────────────────
# immediate = envoi direct (développement) ; database = via « python manage.py db_worker »
# TASK_BACKEND=immediate

# ── Supervision des erreurs (facultatif) ─────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Notifications push (vide = désactivé) ─────────────────────────────
# Générer : python manage.py vapid_keys
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_CONTACT=mailto:contact@fajma.sn

# ── Menu USSD (vide = désactivé) ──────────────────────────────────────
# USSD_SECRET=
